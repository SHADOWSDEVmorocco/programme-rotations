#include <winver.h>
1 ICON "app.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,7,0,0
PRODUCTVERSION 2,7,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Programme des Rotations"
      VALUE "FileDescription", "Programme des Rotations"
      VALUE "FileVersion", "2.7.0"
      VALUE "InternalName", "ProgrammeRotations"
      VALUE "OriginalFilename", "ProgrammeRotations.exe"
      VALUE "ProductName", "Programme des Rotations"
      VALUE "ProductVersion", "2.7.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
